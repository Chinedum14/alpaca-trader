# Copy to ".env" for local runs and fill in your PAPER keys.
# Never commit the real .env (it is gitignored). In GitHub, these go in
# repository Secrets, not the repo itself.

APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret_key

# Optional flags (defaults shown):
# ALPACA_LIVE=0        # 1 = real money. Leave 0 for paper.
# DRY_RUN=0            # 1 = log intended orders without placing them.
# SKIP_IF_CLOSED=1     # 1 = no-op when the market is closed.
